<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen content: Camera stream or map -->
    <SurfaceView
        android:id="@+id/sv_camera_stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <fragment
        android:id="@+id/map_view"
        class="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Overlay: Switch Button on the left-middle -->
    <!-- Overlay: Left-middle panel -->
    <LinearLayout
        android:id="@+id/sliding_panel_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:orientation="vertical"
        android:background="@android:color/darker_gray"
        android:padding="8dp"
        android:translationX="0dp"> <!-- Start visible -->

        <!-- Load Mission Button -->
        <Button
            android:id="@+id/button_load_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load"
            android:layout_gravity="center_vertical|start" />

        <!-- Start Mission Button -->
        <Button
            android:id="@+id/button_start_stop_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:enabled="false"
            android:layout_gravity="center_vertical|start" />

        <Button
            android:id="@+id/button_pause_resume_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:enabled="false"
            android:layout_gravity="center_vertical|start"             />
    </LinearLayout>

    <!-- Small sliding button -->
    <Button
        android:id="@+id/button_toggle_panel_left"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="-120dp"
        android:text="«"
        android:textSize="10sp"
        android:padding="2dp" />


    <!-- Overlay: Top-right ON/OFF switches -->
    <LinearLayout
        android:id="@+id/sliding_panel_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="vertical"
        android:background="@android:color/darker_gray"
        android:padding="8dp"
        android:translationX="0dp"> <!-- Start visible -->

        <!-- Simulator ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_simulator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulator" />

        <!-- RTK ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_rtk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTK" />
    </LinearLayout>

    <Button
        android:id="@+id/button_toggle_panel_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="-120dp"
        android:text="»"
        android:textSize="10sp"
        android:padding="2dp" />

    <!-- Map Button -->
    <Button
        android:id="@+id/button_toggle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Map"
        android:layout_marginBottom="30dp"
        android:layout_gravity="bottom|end" />


    <!-- Additional Information Overlay (Top Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/transparent">

        <!-- Connected Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conn:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_is_drone_connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight to keep position fixed -->

        <!-- Battery Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batt:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Simulator Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sim:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_is_simulator_on"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yaw:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_drone_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Altitude -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alt:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_drone_altitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Gimbal Pitch/Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gimbal P/W:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_gimbal_pitch_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->
    </LinearLayout>


    <!-- Additional Information Overlay (Bottom Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/transparent">

        <!-- Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log:"
            android:layout_marginStart="30dp"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight to keep position fixed -->

        <!-- RTK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTK status:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_rtk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

    </LinearLayout>

</FrameLayout>
