<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen content: Camera stream or map -->
    <SurfaceView
        android:id="@+id/sv_camera_stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Overlay: Switch Button on the left-middle -->
    <!-- Overlay: Left-middle panel -->
    <LinearLayout
        android:id="@+id/sliding_panel_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp"
        android:translationX="0dp"> <!-- Start visible -->

        <!-- Load Mission Button -->
        <Button
            android:id="@+id/button_load_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_mission_button"
            android:layout_gravity="center_vertical|start" />

        <!-- Start Mission Button -->
        <Button
            android:id="@+id/button_start_stop_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_mission_button"
            android:enabled="false"
            android:layout_gravity="center_vertical|start" />

        <Button
            android:id="@+id/button_pause_resume_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause_mission_button"
            android:enabled="false"
            android:layout_gravity="center_vertical|start"             />
    </LinearLayout>

    <!-- Small sliding button -->
    <Button
        android:id="@+id/button_toggle_panel_left"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="-120dp"
        android:text="@string/slide_left"
        android:textSize="11sp"
        android:padding="2dp" />


    <!-- Overlay: Top-right ON/OFF switches -->
    <LinearLayout
        android:id="@+id/sliding_panel_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp"
        android:translationX="0dp"> <!-- Start visible -->

        <!-- Simulator ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_simulator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/simulator_switch" />

        <!-- RTK ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_rtk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/rtk_switch" />
    </LinearLayout>

    <Button
        android:id="@+id/button_toggle_panel_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="-120dp"
        android:text="@string/slide_right"
        android:textSize="11sp"
        android:padding="2dp" />

    <!-- Map Button -->
    <Button
        android:id="@+id/button_toggle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/map_button"
        android:layout_marginBottom="30dp"
        android:layout_gravity="bottom|end" />


    <!-- Additional Information Overlay (Top Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#80000000"> <!-- 50% transparent gray -->

        <!-- Connected Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_is_drone_connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight to keep position fixed -->

        <!-- Simulator Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/simulator_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_is_simulator_on"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Battery Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/battery_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drone_yaw_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_drone_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Altitude -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drone_altitude_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_drone_altitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Speed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drone_speed_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_drone_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Gimbal Pitch/Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gimbal_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_gimbal_pitch_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="2dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- RTK Status -->
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/rtk_label"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:padding="2dp" />-->

<!--        <TextView-->
<!--            android:id="@+id/textview_rtk"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/empty_label"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:padding="2dp"-->
<!--            android:layout_weight="1" />-->

        <!-- Home Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_label"
            android:textColor="#FFFFFF"
            android:padding="2dp" />

        <TextView
            android:id="@+id/textview_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:padding="2dp"
            android:layout_weight="1" />
    </LinearLayout>


    <!-- Semi-Transparent Gray Overlay Layout (Bottom Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#80000000"> <!-- 50% transparent gray -->

        <!-- Log Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_label"
            android:textColor="#FFFFFF"
            android:padding="2dp" />

        <!-- Log Value -->
        <TextView
            android:id="@+id/textview_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_label"
            android:textColor="#FFFFFF"
            android:padding="2dp"
            android:layout_weight="1" />
    </LinearLayout>


</FrameLayout>
