<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen content: Camera stream or map -->
    <SurfaceView
        android:id="@+id/sv_camera_stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <fragment
        android:id="@+id/map_view"
        class="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Overlay: Switch Button on the left-middle -->
    <Button
        android:id="@+id/button_toggle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Map"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp" />

    <Button
        android:id="@+id/button_load_mission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LoadM"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/button_start_mission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StartM"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="80dp" />

    <!-- Overlay: Top-right ON/OFF switches -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="vertical"
        android:background="@android:color/darker_gray"
        android:padding="8dp">

        <!-- Simulator ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_simulator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulator" />

        <!-- RTK ON/OFF switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_rtk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTK" /> <!-- Add spacing between switches -->

    </LinearLayout>

    <!-- Additional Information Overlay (Top Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/transparent">

        <!-- Connected Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_is_drone_connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight to keep position fixed -->

        <!-- Battery Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Simulator Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulator:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_is_simulator_on"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Drone Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drone yaw:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_drone_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->

        <!-- Gimbal Pitch/Yaw -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gimbal pitch/yaw:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_gimbal_pitch_yaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp"
            android:layout_weight="1" /> <!-- Added layout_weight -->
    </LinearLayout>


    <!-- Additional Information Overlay (Bottom Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/transparent">

        <!-- Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log:"
            android:textColor="#FFFFFF"
            android:layout_gravity="start"
            android:padding="5dp" />

        <TextView
            android:id="@+id/textview_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:padding="5dp" />

    </LinearLayout>

</FrameLayout>
